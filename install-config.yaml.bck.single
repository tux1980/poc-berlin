apiVersion: v1
baseDomain: ocp.polizei.test
metadata:
  name: pb-poc
compute:
  - architecture: amd64
    hyperthreading: Enabled
    name: worker
    replicas: 0 # Must be 0 so master nodes are schedulable for workloads
controlPlane:
  architecture: amd64
  hyperthreading: Enabled
  name: master
  replicas: 3 # Configures high availability with 3 master nodes
networking:
  clusterNetwork:
    - cidr: 10.128.0.0/14
      hostPrefix: 23
  machineNetwork:
    - cidr: 192.168.60.0/24
  networkType: OVNKubernetes
  serviceNetwork:
    - 172.30.0.0/16
platform:
  baremetal:
    apiVIPs:
      - 192.168.60.10    # Virtual IP for api.pb-poc.ocp.polizei.test
    ingressVIPs:
      - 192.168.60.20    # Virtual IP for *.apps.pb-poc.ocp.polizei.test
fips: false
pullSecret: '${PULL_SECRET}'
sshKey: '${SSH_KEY}'
additionalTrustBundle: |
${REGISTRY_CA}
imageDigestSources:
  - mirrors:
      - storm4.ocp.polizei.test:5000/openshift/release/openshift/release-images
    source: quay.io/openshift-release-dev/ocp-release
  - mirrors:
      - storm4.ocp.polizei.test:5000/openshift/release/openshift/release
    source: quay.io/openshift-release-dev/ocp-v4.0-art-dev
